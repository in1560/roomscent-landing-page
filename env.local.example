# คัดลอกไฟล์นี้เป็น .env.local (ห้าม commit .env.local เข้า git เด็ดขาด)
# .env.local ต้องอยู่ใน .gitignore อยู่แล้วโดยปกติของ Next.js

# ⚠️ Token นี้เคยถูกพิมพ์ในแชทมาก่อน แนะนำให้ไปที่ @BotFather > /mybots
# แล้ว Revoke token เดิม ขอใหม่ แล้วเอามาใส่แทนตรงนี้ก่อนใช้งานจริง
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=8636419247:AAEpVxg4eRPSReUeborPCJHcLtcLLIeqfBM

# ใช้ตัวเลข ไม่ใช่ @username เพราะรูปแบบ -100XXXXXXXXXX คือ ID ของ Channel/Supergroup
# (บอทต้องถูกเพิ่มเป็น Admin ของ channel นี้ไว้ก่อนแล้ว)
NEXT_PUBLIC_TELEGRAM_CHAT_ID=-1004497747710

# ใส่ค่า Supabase ของโปรเจกต์คุณเอง
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
